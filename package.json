{
  "name": "mr.koa",
  "version": "1.0.2",
  "description": "The most beautiful koa boilerplate.",
  "main": "index.js",
  "engines": {
    "node": "23.x",
    "npm": "11.x"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "test": "npm run specs && jest",
    "test:coverage": "npm run specs && jest --coverage",
    "test:watch": "npm run specs && jest --watch",
    "dev": "npm run specs && nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "start": "node index.js",
    "db:create": "sequelize db:create",
    "db:create:test": "sequelize db:create --env test",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:test": "sequelize db:migrate --env test",
    "build": "npm run specs && tsc --project tsconfig.production.json && npm run db:migrate",
    "build:check": "npm run specs && tsc --noEmit",
    "specs": "mkdir -p src/types/api && openapi-typescript specs/openapi.json --output src/types/api/index.d.ts",
    "dot-only-hunter": "dot-only-hunter test",
    "postinstall": "husky install",
    "unused-exports": "ts-unused-exports tsconfig.json --excludePathsFromReport=src/types/api"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@types/bluebird": "^3.5.36",
    "@types/json-schema": "^7.0.9",
    "@types/validator": "^13.7.1",
    "ajv": "^8.9.0",
    "bcrypt": "^5.0.1",
    "dotenv": "^16.4.5",
    "i18n": "^0.13.4",
    "json-schema-deref-sync": "^0.14.0",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.3.0",
    "koa-json": "^2.0.2",
    "koa-logger": "^3.2.1",
    "koa-qs": "^3.0.0",
    "koa-router": "^13.0.1",
    "lodash": "^4.17.21",
    "mr-error": "^0.7.3",
    "mr-use-case": "^0.8.1",
    "nyc": "^15.1.0",
    "openapi-jsonschema-parameters": "^12.1.3",
    "openapi-typescript": "^7.4.2",
    "pg": "^8.7.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.2",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.14.0",
    "@types/bcrypt": "^5.0.0",
    "@types/faker": "^5.5.9",
    "@types/i18n": "^0.13.2",
    "@types/jest": "^29.5.14",
    "@types/jest-json-schema": "^6.1.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/koa": "^2.13.4",
    "@types/koa__cors": "^3.1.1",
    "@types/koa-bodyparser": "^4.3.5",
    "@types/koa-json": "^2.0.20",
    "@types/koa-logger": "^3.1.2",
    "@types/koa-qs": "^2.0.0",
    "@types/koa-router": "^7.4.4",
    "@types/lodash": "^4.14.170",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "dot-only-hunter": "^1.0.3",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.8.3",
    "faker": "5.5.3",
    "globals": "^15.11.0",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "jest-json-schema": "^6.1.0",
    "nock": "^13.2.2",
    "openapi-types": "^12.1.3",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-unused-exports": "^10.1.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "koa",
    "boilerplate"
  ],
  "author": "Ilia Donskikh",
  "license": "ISC"
}
